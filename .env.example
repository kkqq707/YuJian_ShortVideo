# ==============================================================
# 煜见光影 SaaS 平台 — 环境变量配置模板
# 复制此文件为 .env 并填写实际值
# .env 文件已加入 .gitignore，不会被提交到仓库
# ==============================================================

# ─── 服务端口 ────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── 数据库配置 ──────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=yujian
DB_USER=root
DB_PASSWORD=your_password

# ─── JWT 配置 ────────────────────────────────────────────────
# 生成方式：node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_change_this
JWT_EXPIRES_IN=7d

# ─── 阿里云百炼 DashScope 配置 ───────────────────────────────
# API Key：从阿里云百炼控制台获取 https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=
# 请求地址（生产环境无需修改）
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
# 默认视频生成模型，对应 registry 中的 apiModelName，可选：happyhorse-t2v / happyhorse-1.1-i2v / wanx-digital-human
# 留空则使用各接口内置默认值
DASHSCOPE_VIDEO_MODEL=
# API 请求超时时间（毫秒）
DASHSCOPE_REQUEST_TIMEOUT=30000
# 回调签名密钥：用于验证 DashScope 回调请求的 HMAC-SHA256 签名
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DASHSCOPE_CALLBACK_SECRET=

# ─── 阿里云 OSS 对象存储配置 ─────────────────────────────────
# AccessKey：从 RAM 访问控制获取 https://ram.console.aliyun.com/
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 存储区域，例如 oss-cn-beijing / oss-cn-shanghai
OSS_REGION=oss-cn-beijing
# 存储桶名称
OSS_BUCKET=
# OSS 访问域名，格式：https://{bucket}.{region}.aliyuncs.com
OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
# 自定义域名（可选，CDN 加速场景）
OSS_DOMAIN=

# ─── 应用配置 ────────────────────────────────────────────────
APP_BASE_URL=http://localhost:3000

# ─── 短信验证码（Auth-Rebuild-003）──────────────────────────
# 开发环境（NODE_ENV !== production）使用 Mock 验证码：SMS_MOCK_CODE，默认 123456。
# Mock 验证码只在受控开发日志输出，绝不写入 API response；生产环境绝不使用固定验证码。
# 生产环境必须配置以下阿里云短信密钥才能真实发码（本阶段尚未接入真实短信，未配置时拒绝发送）。
SMS_MOCK_CODE=
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=

# ─── 计费旁路（开发环境）─────────────────────────────────────
# 开启后 adjustEnterpriseQuota 跳过全部计费逻辑：不扣积分、不检查余额、
# 不写 QuotaLog、不改变数据库余额，直接返回 { success: true, balance: null, devBypass: true }。
# 仅用于开发环境排查生成链路问题（如 BILLING_FAILED 误诊断），生产环境必须关闭。
# 开启条件：1 / true / on 均视为开启；置空或删除则恢复原 Billing 行为。
BILLING_BYPASS=
